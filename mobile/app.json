{
  "expo": {
    "name": "ASM — Assistance Sociale Médicale",
    "slug": "asm-sante",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "asmsante",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.asmsante.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.asm_sante.twa",
      "adaptiveIcon": {
        "backgroundColor": "#0E6B3F",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID protège l'accès à vos informations médicales dans ASM."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ASM accède à vos photos pour joindre une ordonnance ou un bon de transport à votre dossier.",
          "cameraPermission": "ASM utilise l’appareil photo pour photographier une ordonnance ou un bon de transport."
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://www.asm-sante.com",
      "eas": {
        "projectId": "a3f85fc4-d36f-4a55-80d2-b02438f29400"
      }
    },
    "owner": "asm-sante",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a3f85fc4-d36f-4a55-80d2-b02438f29400"
    }
  }
}
